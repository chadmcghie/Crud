{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error",
      "Api": "Debug",
      "App": "Debug",
      "Infrastructure": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "Api": "Debug",
        "App": "Debug",
        "Infrastructure": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=TestDatabase.db"
  },
  "Testing": {
    "EnableDatabaseReset": true
  },
  "Jwt": {
    "Secret": "ThisIsATestSecretKeyForIntegrationTestsThatShouldBeAtLeast32Characters123!",
    "Issuer": "CrudApiTest",
    "Audience": "CrudApiTestUsers"
  },
  "FeatureManagement": {
    "Swagger": true,
    "DatabaseSeeding": true,
    "DetailedExceptions": true,
    "HealthChecksDetailed": true
  }
}